# Weather API Configuration
API_BASE_URL=https://api.openweathermap.org
API_KEY=your_openweather_api_key_here

# Session Configuration (Change in production!)
SESSION_SECRET=your-secret-session-key-change-in-production

# Database Configuration
# For local development, you can use a local PostgreSQL database or leave empty to skip DB features
# Railway will automatically provide DATABASE_URL in production
DATABASE_URL=postgresql://user:password@localhost:5432/weather_dashboard

# Environment
# For Railway deployment, set NODE_ENV=production in Railway environment variables
NODE_ENV=development
PORT=3001
